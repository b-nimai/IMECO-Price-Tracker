# Copy to .env and fill in. See README "Setup" for where each value comes from.
#
# The packaged desktop app does NOT read this file — it prompts on first launch and stores
# secrets in Windows Credential Manager. This is for running from source during development.

# ── Bright Data (OPTIONAL — leave blank) ────────────────────────────────────────
# Not required. All four marketplaces fetch directly from a residential IP; this is a dormant
# escalation path that fires only if one of them starts refusing this machine.
# To activate: add a key, and create a Web Unlocker zone (NOT Proxy, NOT Browser API).
BRIGHTDATA_API_KEYS=""
BRIGHTDATA_ZONE=""

# ── Supabase ────────────────────────────────────────────────────────────────────
# supabase.com -> your project -> Project Settings -> API
SUPABASE_URL="https://xxxxxxxx.supabase.co"
# service_role / secret key: bypasses RLS, has WRITE access.
# Desktop app only. Never put this in the dashboard or commit it.
SUPABASE_SERVICE_KEY=""

# ── Dashboard (Vite inlines these into the public bundle) ───────────────────────
# Same project URL, but the anon/public key. Safe to ship publicly *because* RLS
# restricts the anon role to SELECT — verify that before deploying.
VITE_SUPABASE_URL="https://xxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY=""
